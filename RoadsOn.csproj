<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoadsOn</RootNamespace>
    <AssemblyName>RoadsOn</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <!-- Ensure static web content and data directory are copied to publish directory -->
  <ItemGroup>
    <Content Include="index.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="iletisim.html" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="admin\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\**\*" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="data\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
